<mvc:View
    controllerName="com.gsp.sap.procurement.ui.poautomationui.controller.Login"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page id="pageLoginCyber" showHeader="false" class="loginPage sapUiNoContentPadding">
        <content>
            <HBox id="hboxSplitMain" class="splitLoginContainer" alignItems="Stretch">
                
                <VBox id="vboxHeroSide" class="loginHeroSide" alignItems="Center" justifyContent="Center" visible="{= !${device>/system/phone} }">
                    <VBox id="vboxHeroGlass" alignItems="Center" class="heroBrandingBox">
                        <VBox id="vboxLogoWrap" class="logoBacklight sapUiLargeMarginBottom">
                            <Image id="ImgSAPLogo" src="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg" width="150px"/>
                        </VBox>
                        <Title id="titleAppBrand" text="BTP PROCUREMENT" level="H1" class="neonTitleText"/>
                        <Text id="textAppSub" text="Hệ thống tự động hóa chứng từ" class="heroSubTextCyber"/>
                    </VBox>
                </VBox>

                <VBox id="vboxFormSide" class="loginFormSide" alignItems="Center" justifyContent="Center">
                    <VBox id="vboxLoginCard" class="cyberLoginCard">
                        
                        <Title id="titleLogin" text="ĐĂNG NHẬP HỆ THỐNG" level="H2" class="formTitleHighContrast sapUiMediumMarginBottom"/>

                        <VBox id="vboxFields" class="loginFormInner">
                            <Label id="lblUser" text="Tên đăng nhập" class="labelCyber" labelFor="inputUsername"/>
                            <Input id="inputUsername" placeholder="email@company.com" class="loginInputCyber sapUiSmallMarginBottom"/>
                            
                            <Label id="lblPass" text="Mật khẩu" class="labelCyber" labelFor="inputPassword"/>
                            <Input id="inputPassword" type="Password" placeholder="••••••••" class="loginInputCyber sapUiSmallMarginBottom"/>
                            
                            <Button id="btnSignIn" text="XÁC NHẬN ĐĂNG NHẬP" type="Emphasized" press="onStandardLogin" class="btnCyberAction sapUiMediumMarginBottom"/>
                        </VBox>

                        <HBox id="hboxDiv" class="dividerSectionCyber" alignItems="Center" justifyContent="Center">
                            <core:HTML id="htmlL" content="&lt;div class='lineCyber'&gt;&lt;/div&gt;"/>
                            <Text id="txtOr" text="HOẶC" class="textMutedCyber sapUiSmallMarginBeginEnd"/>
                            <core:HTML id="htmlR" content="&lt;div class='lineCyber'&gt;&lt;/div&gt;"/>
                        </HBox>

                        <VBox id="vboxQuick" class="quickLoginSection">
                            <Title id="tiQuick" text="TRUY CẬP NHANH (DEMO MODE)" level="H4" class="quickTitleCyan sapUiSmallMarginBottom"/>
                            <HBox id="hboxRoles" class="roleGridCyber">
                                <Button id="btnEmp" text="NHÂN VIÊN" icon="sap-icon://employee" press="onQuickLoginEmployee" class="btnDemoBlackText roleEmp"/>
                                <Button id="btnMgr" text="QUẢN LÝ" icon="sap-icon://manager" press="onQuickLoginManager" class="btnDemoBlackText roleMgr"/>
                                <Button id="btnAdm" text="ADMIN" icon="sap-icon://settings" press="onQuickLoginAdmin" class="btnDemoBlackText roleAdm"/>
                            </HBox>
                        </VBox>

                        <VBox id="vboxFooter" alignItems="Center" class="sapUiLargeMarginTop">
                            <Link id="lnkHome" text="← Trở lại Trang Chủ" press="onBackToLanding" class="lnkCyber"/>
                            <HBox id="hbReg" class="sapUiTinyMarginTop" alignItems="Center">
                                <Text id="txNoAcc" text="Chưa có tài khoản?" class="textMutedCyber sapUiTinyMarginEnd"/>
                                <Link id="lnkReg" text="Đăng ký ngay" press="onRegisterPress" class="lnkCyberHighlight"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
                
            </HBox>
        </content>
    </Page>
</mvc:View>