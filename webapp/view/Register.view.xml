<mvc:View
    controllerName="com.gsp.sap.procurement.ui.poautomationui.controller.Register"
    xmlns:mvc="sap.ui.core.mvc" xmlns:sap.ui.layout="sap.ui.layout" xmlns="sap.m" xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page id="pageRegisterCyber" showHeader="false" class="loginPage sapUiNoContentPadding">
        <content>
            <HBox id="hboxRegSplit" class="splitLoginContainer" alignItems="Stretch">
                
                <VBox id="vboxRegHero" class="loginHeroSide" alignItems="Center" justifyContent="Center" visible="{= !${device>/system/phone} }">
                    <VBox id="vboxRegHeroGlass" alignItems="Center" class="heroBrandingBox">
                        <VBox id="vboxRegLogoWrap" class="logoBacklight sapUiLargeMarginBottom">
                            <Image id="imgRegLogo" src="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg" width="140px"/>
                        </VBox>
                        <Title id="titleRegApp" text="BTP PROCUREMENT" level="H1" class="neonTitleText"/>
                        <Text id="textRegSlogan" text="Kiến tạo quy trình thu mua thông minh" class="heroSubTextCyber"/>
                    </VBox>
                </VBox>

                <VBox id="vboxRegFormSide" class="loginFormSide" alignItems="Center" justifyContent="Center">
                    <VBox id="vboxRegCard" class="cyberLoginCard">
                        
                        <Title id="tiRegForm" text="TẠO TÀI KHOẢN MỚI" level="H2" class="formTitleHighContrast sapUiMediumMarginBottom"/>

                        <VBox id="vboxRegFields" class="loginFormInner">
                            <Label id="lblFullName" text="Họ và tên *" class="labelCyber" labelFor="inputFullName"/>
                            <Input id="inputFullName" placeholder="Nhập họ và tên..." class="loginInputCyber sapUiSmallMarginBottom"/>
                            
                            <Label id="lblRegEmail" text="Email doanh nghiệp *" class="labelCyber" labelFor="inputEmail"/>
                            <Input id="inputEmail" type="Email" placeholder="example@company.com" class="loginInputCyber sapUiSmallMarginBottom"/>

                            <HBox id="hboxRegPassRow" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                <VBox id="vbP1" width="48%">
                                    <Label id="lbP1" text="Mật khẩu *" class="labelCyber" labelFor="inputRegPass"/>
                                    <Input id="inputRegPass" type="Password" placeholder="••••••••" class="loginInputCyber"/>
                                </VBox>
                                <VBox id="vbP2" width="48%">
                                    <Label id="lbP2" text="Xác nhận *" class="labelCyber" labelFor="inputConfirmPass"/>
                                    <Input id="inputConfirmPass" type="Password" placeholder="••••••••" class="loginInputCyber"/>
                                </VBox>
                            </HBox>
                            
                            <Label id="lblRegRole" text="Vai trò hệ thống *" class="labelCyber"/>
                            <Select id="selectRegRole" width="100%" class="selectDarkRefined sapUiSmallMarginBottom">
                                <items>
                                    <core:Item id="itEmp" key="employee" text="Nhân viên Thu mua"/>
                                    <core:Item id="itMgr" key="manager" text="Quản lý Phê duyệt"/>
                                </items>
                            </Select>
                            
                            <Button id="btnSubmitReg" text="HOÀN TẤT ĐĂNG KÝ" type="Emphasized" press="onRegister" class="btnCyberActionRefined sapUiMediumMarginTop"/>
                        </VBox>

                        <VBox id="vboxRegFoot" alignItems="Center" class="sapUiLargeMarginTop">
                            <HBox id="hbLog" alignItems="Center">
                                <Text id="txHaveAcc" text="Đã có tài khoản?" class="textMutedCyber sapUiTinyMarginEnd"/>
                                <Link id="lnkLog" text="Đăng nhập ngay" press="onBackToLogin" class="lnkCyberHighlight"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>

            </HBox>
        </content>
    </Page>
</mvc:View>